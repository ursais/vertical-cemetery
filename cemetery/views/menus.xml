<odoo>
    <menuitem id="cemetery_menu_root"
        name="Cemetery"
        sequence="5"
        groups="cemetery.group_cemetery_user"
        >
    </menuitem>

    <menuitem id="menu_cemetery_location" name="Dashboard" action="cemetery_location_dashboard_action"
    parent="cemetery_menu_root" sequence="1"/>

    <menuitem id="menu_cemetery_location_operations" name="Operations" 
    parent="cemetery_menu_root" sequence="2"/>

    <menuitem id="submenu_cemetery_location_operations" name="Locations" action="cemetery_location_operations_action"
    parent="menu_cemetery_location_operations" sequence="1"/>

    <menuitem id="menu_cemetery_master_data" name="Master Data" 
    parent="cemetery_menu_root" sequence="2"/>

    <menuitem id="submenu_cemetery_master_data" name="Beneficiaries" action="cemetery_beneficiary_action"
    parent="menu_cemetery_master_data" sequence="1"/>

    <menuitem id="submenu_contacts_master_data"    name="Contacts" 
        action="cemetery_partner_action" 
        parent="menu_cemetery_master_data" 
        sequence="2"
    />

    <menuitem id="menu_cemetery_reporting" name="Reports" 
    parent="cemetery_menu_root" sequence="3"/>

    <menuitem id="menu_cemetery_move_history_report" name="Move History" action="cemetery_stock_move_line_action"
    parent="menu_cemetery_reporting" sequence="1"/>


    <menuitem id="configuration_menu_root"
    name="Configuration" sequence="5"
    groups="cemetery.group_cemetery_manager"
    parent="cemetery_menu_root"/>

    <menuitem id="menu_cemetery_general_settings" name="Settings" parent="configuration_menu_root"
    sequence="0" action="action_cemetery_config_settings" groups="cemetery.group_cemetery_manager"/>

    <menuitem id="menu_cemetery_config" name="Cemeteries" action="cemetery_action"
    parent="configuration_menu_root" sequence="1" groups="cemetery.group_cemetery_manager"/>

    <menuitem id="menu_cemetery_location_config" name="Locations" action="cemetery_location_config_action"
    parent="configuration_menu_root" sequence="2" groups="cemetery.group_cemetery_manager"/>
</odoo>