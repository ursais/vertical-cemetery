<odoo>
    <record id="cemetery_location_view_kanban" model="ir.ui.view">
    <field name="name">cemetery.location.view.kanban</field>
    <field name="model">cemetery.location</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_dashboard o_emphasize_colors" create="0" group_create="false">
            <field name="cemetery_id"/>
            <field name="parent_id"/>
            <templates>
                <t t-name="kanban-box">
                    <!-- Kanban Card Header -->
                    <div>
                        <div t-attf-class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <div class="o_primary">
                                    <field name="name"/>
                                </div>
                                <div class="o_secondary">
                                    <!-- Warehouse Name -->
                                    <field class="o_secondary" name="warehouse_id" readonly="1" groups="stock.group_stock_multi_warehouses"/>
                                </div>
                                <div class="row">
                                    <!-- Available Space -->
                                    <div class="o_primary col-6 o_kanban_primary_left">
                                        <span>Available Space: </span><field name="available_space"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Available Space -->
                                    <div class="o_primary col-6 o_kanban_primary_left">
                                        <span>Occupied Space: </span><field name="occupied_space"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Kanban Card Content -->
                    </div>
                </t>
            </templates>
            </kanban>
        </field>
    </record>





    <!--Add an action to open the Kanban view-->
    <record id="cemetery_location_dashboard_action" model="ir.actions.act_window">
        <field name="name">Location Overview</field>
        <field name="res_model">cemetery.location</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="cemetery_location_view_kanban"/>
        <field name="context">{'is_cemetery_location_kanban':1}</field>
    </record>

    <record id="view_stock_location_form_inherit_cemetery" model="ir.ui.view">
        <field name="name">stock.location.form</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <field name="usage" position="before">
                <field name="is_cemetery_location" groups="cemetery.group_cemetery_user"/>
            </field>
        </field>
    </record>

    <record id="view_location_form_inherit_cemetery" model="ir.ui.view">
        <field name="name">stock.location.form</field>
        <field name="model">cemetery.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//group[1]//group[3]" position="after">
                <group name="cemetery" string="Cemetery">
                    <field name="is_cemetery_location"/>
                    <field name="cemetery_location_type"/>
                    <field name="cemetery_id"/>
                    <field name="parent_id"/>
                    <field name="partner_id" context="{'is_cemetery_location':True}"/>
                </group>
            </xpath>

            <field name="comment" position="after">
                 <notebook>
                        <page string="Beneficiaries" name="beneficiaries">
                            <field name="beneficiary_ids" mode="tree">
                                <tree editable="bottom">
                                    <field name="partner_id" required="1" context="{'is_cemetery_partner':1}"/>
                                    <field name="serial_id"/>
                                    <field name="beneficiary_type"/>
                                    <field name="death_date"/>
                                    <field name="last_movement_date"/>
                                    <field name="cemetery_location_id" readonly="1"/>
                                    <field name="dest_cemetery_location_id" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
            </field>

        </field>
    </record>

    <record id="cemetery_location_config_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">cemetery.location</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_in_location':1,'default_is_cemetery_location':1}</field>
        <field name="search_view_id" ref="stock.view_location_search"/>
    </record>

    <record id="cemetery_location_action_tree" model="ir.actions.act_window.view">
        <field name="view_mode">tree</field>
        <field name="view_id" ref="stock.view_location_tree2"/>
        <field name="act_window_id" ref="cemetery.cemetery_location_config_action"/>
    </record>

    <record id="cemetery_location_action_form" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="cemetery.view_location_form_inherit_cemetery"/>
        <field name="act_window_id" ref="cemetery.cemetery_location_config_action"/>
    </record>

    <record id="cemetery_location_operations_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">cemetery.location</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_in_location':1,'default_is_cemetery_location':1}</field>
        <field name="search_view_id" ref="stock.view_location_search"/>
    </record>

    <record id="cemetery_location_action_tree_operations" model="ir.actions.act_window.view">
        <field name="view_mode">tree</field>
        <field name="view_id" ref="stock.view_location_tree2"/>
        <field name="act_window_id" ref="cemetery.cemetery_location_operations_action"/>
    </record>

    <record id="cemetery_location_action_form_operations" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="cemetery.view_location_form_inherit_cemetery"/>
        <field name="act_window_id" ref="cemetery.cemetery_location_operations_action"/>
    </record>

</odoo>