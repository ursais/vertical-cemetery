<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.cemetery</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="Cemetery Info" name="cemetery">
                    <group>
                        <group string="Cemetery Details" name="cemetery_details">
                            <field name="is_cemetery_beneficiary"/>
                            <field name="is_cemetery_location"/>
                            <field name="cemetery_id"/>
                        </group>
                        <group string="Beneficiary Details" name="beneficiary_details" invisible="not is_cemetery_beneficiary">
                            <field name="cemetery_beneficiary_type" required="is_cemetery_beneficiary"/>
                            <field name="beneficiary_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="cemetery_partner_action" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="cemetery_partner_view_tree_act" model="ir.actions.act_window.view">
        <field name="view_mode">tree</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="act_window_id" ref="cemetery.cemetery_partner_action"/>
    </record>

    <record id="cemetery_partner_view_form_act" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form"/>
        <field name="act_window_id" ref="cemetery.cemetery_partner_action"/>
    </record>

</odoo>
