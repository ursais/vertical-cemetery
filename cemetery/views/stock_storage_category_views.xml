<odoo>

<!-- Actions -->
    <record id="action_storage_category_cemetery" model="ir.actions.act_window">
        <field name="name">Storage Categories</field>
        <field name="res_model">stock.storage.category</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="stock.stock_storage_category_tree"/>
        <field name="context">{'default_is_cemetery':1}</field>
    </record>

<!-- Views -->

    <record id="view_stock_storage_category_form_inherit_cemetery" model="ir.ui.view">
        <field name="name">stock.storage.category.form.cemetery</field>
        <field name="model">stock.storage.category</field>
        <field name="inherit_id" ref="stock.stock_storage_category_form"/>
        <field name="arch" type="xml">
            <field name="allow_new_product" position="after">
                <field name="is_cemetery" groups="cemetery.group_cemetery_user"/>
            </field>
        </field>
    </record>

</odoo>
